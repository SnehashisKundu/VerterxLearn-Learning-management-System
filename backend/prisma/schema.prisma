generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                 @id @default(uuid()) @db.Uuid
  fullName                String                 @map("full_name") @db.VarChar(150)
  email                   String                 @unique @db.VarChar(180)
  passwordHash            String                 @map("password_hash") @db.VarChar(255)
  avatarUrl               String?                @map("avatar_url")
  isActive                Boolean                @default(true) @map("is_active")
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  aiChatSessions          AIChatSession[]
  announcements           Announcement[]
  assignmentSubmissions   AssignmentSubmission[]
  attendanceSessions      AttendanceSession[]
  attendances             Attendance[]
  auditLogs               AuditLog[]
  bookmarks               Bookmark[]
  certificates            Certificate[]
  reviewedCourseApprovals CourseApproval[]       @relation("CourseApprovalReviewer")
  courseApprovals         CourseApproval[]
  courses                 Course[]
  discussionPosts         DiscussionPost[]
  discussionThreads       DiscussionThread[]
  enrollments             Enrollment[]
  uploadedFiles           FileAsset[]
  notes                   Note[]
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  payments                Payment[]
  pointTransactions       PointTransaction[]
  pointWallet             PointWallet?
  quizAttempts            QuizAttempt[]
  recommendations         Recommendation[]
  refreshTokens           RefreshToken[]
  redemptions             RewardRedemption[]
  streak                  Streak?
  studentIdCard           StudentIdCard?
  studyPlans              StudyPlan[]
  topicMasteries          TopicMastery[]
  userBadges              UserBadge[]
  userRoles               UserRole[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(30)
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId Int    @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Course {
  id                 String              @id @default(uuid()) @db.Uuid
  instructorId       String              @map("instructor_id") @db.Uuid
  title              String              @db.VarChar(200)
  description        String?
  category           String?             @db.VarChar(80)
  difficulty         String?             @db.VarChar(20)
  thumbnailUrl       String?             @map("thumbnail_url")
  price              Decimal             @default(0) @db.Decimal(10, 2)
  status             String              @default("pending") @db.VarChar(20)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  aiChatSessions     AIChatSession[]
  announcements      Announcement[]
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  certificates       Certificate[]
  courseApprovals    CourseApproval[]
  instructor         User                @relation(fields: [instructorId], references: [id])
  discussionThreads  DiscussionThread[]
  documentChunks     DocumentChunk[]
  enrollments        Enrollment[]
  modules            Module[]
  payments           Payment[]
  recommendations    Recommendation[]
  studyPlans         StudyPlan[]
  topicMasteries     TopicMastery[]

  @@index([instructorId])
  @@index([status])
  @@index([category])
  @@index([difficulty])
  @@map("courses")
}

model Module {
  id         String      @id @default(uuid()) @db.Uuid
  courseId   String      @map("course_id") @db.Uuid
  title      String      @db.VarChar(200)
  orderIndex Int         @map("order_index")
  flashcards Flashcard[]
  lectures   Lectures[]
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes    Quiz[]

  @@index([courseId])
  @@map("modules")
}

model Lectures {
  id               String            @id @default(uuid()) @db.Uuid
  moduleId         String            @map("module_id") @db.Uuid
  title            String            @db.VarChar(200)
  videoUrl         String?           @map("video_url")
  transcript       String?
  durationSeconds  Int?              @map("duration_seconds")
  orderIndex       Int               @map("order_index")
  resourceUrls     String[]          @map("resource_urls")
  bookmarks        Bookmark[]
  documentChunks   DocumentChunk[]
  progress         LectureProgress[]
  resources        LectureResource[]
  module           Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  notes            Note[]
  generatedQuizzes Quiz[]            @relation("GeneratedQuizLecture")

  @@index([moduleId])
  @@map("lectures")
}

model Enrollment {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  courseId        String            @map("course_id") @db.Uuid
  enrolledAt      DateTime          @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  progressPercent Decimal           @default(0) @map("progress_percent") @db.Decimal(5, 2)
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lectureProgress LectureProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LectureProgress {
  id             String     @id @default(uuid()) @db.Uuid
  enrollmentId   String     @map("enrollment_id") @db.Uuid
  lectureId      String     @map("lecture_id") @db.Uuid
  watchedSeconds Int        @default(0) @map("watched_seconds")
  completed      Boolean    @default(false)
  lastWatchedAt  DateTime?  @map("last_watched_at") @db.Timestamptz(6)
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lecture        Lectures   @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lectureId])
  @@index([enrollmentId])
  @@index([lectureId])
  @@map("lecture_progress")
}

model Note {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  lectureId        String   @map("lecture_id") @db.Uuid
  timestampSeconds Int?     @map("timestamp_seconds")
  content          String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lecture          Lectures @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lectureId])
  @@map("notes")
}

model Bookmark {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  lectureId        String   @map("lecture_id") @db.Uuid
  timestampSeconds Int?     @map("timestamp_seconds")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lecture          Lectures @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lectureId])
  @@map("bookmarks")
}

model Assignment {
  id           String                 @id @default(uuid()) @db.Uuid
  courseId     String                 @map("course_id") @db.Uuid
  title        String?                @db.VarChar(200)
  instructions String?
  rubric       Json?
  dueDate      DateTime?              @map("due_date") @db.Timestamptz(6)
  submissions  AssignmentSubmission[]
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  fileUrl      String?    @map("file_url")
  submittedAt  DateTime   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  grade        Decimal?   @db.Decimal(5, 2)
  feedback     String?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
  @@map("assignment_submissions")
}

model Quiz {
  id                     String         @id @default(uuid()) @db.Uuid
  moduleId               String         @map("module_id") @db.Uuid
  title                  String?        @db.VarChar(200)
  isAiGenerated          Boolean        @default(false) @map("is_ai_generated")
  generatedFromLectureId String?        @map("generated_from_lecture_id") @db.Uuid
  attempts               QuizAttempt[]
  questions              QuizQuestion[]
  generatedFromLecture   Lectures?      @relation("GeneratedQuizLecture", fields: [generatedFromLectureId], references: [id])
  module                 Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([generatedFromLectureId])
  @@map("quizzes")
}

model QuizQuestion {
  id           String       @id @default(uuid()) @db.Uuid
  quizId       String       @map("quiz_id") @db.Uuid
  questionText String?      @map("question_text")
  questionType String?      @map("question_type") @db.VarChar(20)
  orderIndex   Int?         @map("order_index")
  difficulty   String       @default("medium") @db.VarChar(20)
  answers      QuizAnswer[]
  options      QuizOption[]
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([difficulty])
  @@map("quiz_questions")
}

model QuizOption {
  id         String       @id @default(uuid()) @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  optionText String?      @map("option_text")
  isCorrect  Boolean      @default(false) @map("is_correct")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id          String       @id @default(uuid()) @db.Uuid
  quizId      String       @map("quiz_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  score       Decimal?     @db.Decimal(5, 2)
  startedAt   DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt DateTime?    @map("submitted_at") @db.Timestamptz(6)
  answers     QuizAnswer[]
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id                String       @id @default(uuid()) @db.Uuid
  attemptId         String       @map("attempt_id") @db.Uuid
  questionId        String       @map("question_id") @db.Uuid
  selectedOptionIds String[]     @map("selected_option_ids") @db.Uuid
  textAnswer        String?      @map("text_answer")
  isCorrect         Boolean?     @map("is_correct")
  attempt           QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_answers")
}

model Certificate {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  courseId       String               @map("course_id") @db.Uuid
  certificateUrl String?              @map("certificate_url")
  issuedAt       DateTime             @default(now()) @map("issued_at") @db.Timestamptz(6)
  templateId     String?              @map("template_id") @db.Uuid
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  template       CertificateTemplate? @relation(fields: [templateId], references: [id])
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

model CertificateTemplate {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(150)
  templateUrl  String        @map("template_url")
  isActive     Boolean       @default(false) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  layout       Json?
  certificates Certificate[]

  @@index([isActive])
  @@map("certificate_templates")
}

model Badge {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  description String?
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String   @map("user_id") @db.Uuid
  badgeId  Int      @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz(6)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([badgeId])
  @@map("user_badges")
}

model PointRule {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  points      Int
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("point_rules")
}

model PointWallet {
  userId    String   @id @map("user_id") @db.Uuid
  balance   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_wallets")
}

model PointTransaction {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  amount      Int
  type        PointTransactionType
  reason      String               @db.VarChar(255)
  referenceId String?              @map("reference_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("point_transactions")
}

model Reward {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(150)
  description String?
  imageUrl    String?            @map("image_url")
  points      Int
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  type        RewardType         @default(DIGITAL)
  redemptions RewardRedemption[]

  @@index([points])
  @@index([isActive])
  @@map("rewards")
}

model RewardRedemption {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  rewardId       String                 @map("reward_id") @db.Uuid
  points         Int
  status         RewardRedemptionStatus @default(PENDING)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  trackingNumber String?                @map("tracking_number") @db.VarChar(100)
  carrier        String?                @db.VarChar(100)
  shippedAt      DateTime?              @map("shipped_at") @db.Timestamptz(6)
  deliveredAt    DateTime?              @map("delivered_at") @db.Timestamptz(6)
  claimedAt      DateTime?              @map("claimed_at") @db.Timestamptz(6)
  fulfilledAt    DateTime?              @map("fulfilled_at") @db.Timestamptz(6)
  reward         Reward                 @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
  @@index([status])
  @@map("reward_redemptions")
}

model Streak {
  userId        String    @id @map("user_id") @db.Uuid
  currentStreak Int       @default(0) @map("current_streak")
  longestStreak Int       @default(0) @map("longest_streak")
  lastActiveAt  DateTime? @map("last_active_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model AIChatSession {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  courseId  String?         @map("course_id") @db.Uuid
  title     String?         @db.VarChar(200)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  messages  AIChatMessage[]
  course    Course?         @relation(fields: [courseId], references: [id])
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@map("ai_chat_sessions")
}

model AIChatMessage {
  id               String        @id @default(uuid()) @db.Uuid
  sessionId        String        @map("session_id") @db.Uuid
  role             String        @db.VarChar(20)
  content          String
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceLectureIds String[]      @map("source_lecture_ids") @db.Uuid
  session          AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_chat_messages")
}

model StudyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String?  @map("course_id") @db.Uuid
  title     String?  @db.VarChar(200)
  planData  Json     @map("plan_data")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  course    Course?  @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@map("study_plans")
}

model Flashcard {
  id       String @id @default(uuid()) @db.Uuid
  moduleId String @map("module_id") @db.Uuid
  front    String
  back     String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("flashcards")
}

model DocumentChunk {
  id           String                 @id @default(uuid()) @db.Uuid
  courseId     String                 @map("course_id") @db.Uuid
  lectureId    String?                @map("lecture_id") @db.Uuid
  content      String
  chunkIndex   Int                    @map("chunk_index")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  embedding    Unsupported("vector")?
  endSeconds   Int?                   @map("end_seconds")
  startSeconds Int?                   @map("start_seconds")
  course       Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecture      Lectures?              @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([lectureId, chunkIndex], map: "document_chunks_lecture_chunk_unique")
  @@index([courseId])
  @@index([lectureId])
  @@index([lectureId, startSeconds, endSeconds])
  @@map("document_chunks")
}

model Recommendation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String?  @map("course_id") @db.Uuid
  reason    String?
  score     Decimal? @db.Decimal(6, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course    Course?  @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@map("recommendations")
}

model DiscussionThread {
  id        String           @id @default(uuid()) @db.Uuid
  courseId  String           @map("course_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(200)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  posts     DiscussionPost[]
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
  @@map("discussion_threads")
}

model DiscussionPost {
  id        String           @id @default(uuid()) @db.Uuid
  threadId  String           @map("thread_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  content   String
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  isFlagged Boolean          @default(false) @map("is_flagged")
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([userId])
  @@map("discussion_posts")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model Announcement {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(200)
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
  @@map("announcements")
}

model CourseApproval {
  id         String    @id @default(uuid()) @db.Uuid
  courseId   String    @map("course_id") @db.Uuid
  reviewerId String?   @map("reviewer_id") @db.Uuid
  status     String    @db.VarChar(20)
  feedback   String?
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userId     String?   @db.Uuid
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviewer   User?     @relation("CourseApprovalReviewer", fields: [reviewerId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@index([courseId])
  @@index([reviewerId])
  @@index([status])
  @@map("course_approvals")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR") @db.Char(3)
  status        String   @db.VarChar(20)
  provider      String?  @db.VarChar(50)
  transactionId String?  @unique @map("transaction_id") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model LectureResource {
  id        String   @id @default(uuid()) @db.Uuid
  lectureId String   @map("lecture_id") @db.Uuid
  type      String   @db.VarChar(30)
  fileUrl   String   @map("file_url")
  title     String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lecture   Lectures @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([type])
  @@map("lecture_resources")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model TopicMastery {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  courseId       String    @map("course_id") @db.Uuid
  topic          String    @db.VarChar(150)
  masteryScore   Decimal   @default(0) @map("mastery_score") @db.Decimal(5, 2)
  questionsSeen  Int       @default(0) @map("questions_seen")
  lastAssessedAt DateTime? @map("last_assessed_at") @db.Timestamptz(6)
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, topic])
  @@index([userId])
  @@index([courseId])
  @@map("topic_mastery")
}

model FileAsset {
  id           String   @id @default(uuid()) @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt   @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@map("file_assets")
}

model ProcessingJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(50)
  status      String    @db.VarChar(20)
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    String    @map("entity_id") @db.Uuid
  error       String?
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@index([entityType, entityId])
  @@map("processing_jobs")
}

model StudentIdCard {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  cardNumber String   @unique @map("card_number") @db.VarChar(50)
  qrToken    String   @unique @map("qr_token")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_id_cards")
}

model AttendanceSession {
  id           String       @id @default(uuid()) @db.Uuid
  courseId     String       @map("course_id") @db.Uuid
  instructorId String       @map("instructor_id") @db.Uuid
  startedAt    DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime?    @map("ended_at") @db.Timestamptz(6)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   User         @relation(fields: [instructorId], references: [id])
  attendances  Attendance[]

  @@index([courseId])
  @@index([instructorId])
  @@map("attendance_sessions")
}

model Attendance {
  id        String            @id @default(uuid()) @db.Uuid
  sessionId String            @map("session_id") @db.Uuid
  studentId String            @map("student_id") @db.Uuid
  scannedAt DateTime          @default(now()) @map("scanned_at") @db.Timestamptz(6)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendances")
}

