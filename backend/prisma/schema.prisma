  REDEEM
  ADJUSTMENT
}

enum RewardType {
  DIGITAL
  PHYSICAL
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  FULFILLED
  CANCELLED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CLAIMED
}
